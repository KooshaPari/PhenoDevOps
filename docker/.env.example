# Storage Configuration for PhenoPolyglot
#
# Copy to .env and customize for your environment

# Dragonfly (Redis-compatible)
DRAGONFLY_URL=redis://localhost:6379
DRAGONFLY_MAX_MEMORY=4gb

# QuestDB (Time-Series)
QUESTDB_URL=http://localhost:9000
QUESTDB_USER=questdb-user
QUESTDB_PASS=CHANGE_ME_QUESTDB_PASSWORD

# Qdrant (Vector Search)
QDRANT_URL=http://localhost:6333
QDRANT_GRPC=localhost:6334

# Meilisearch (Full-Text)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=CHANGE_ME_MEILISEARCH_MASTER_KEY

# NATS (Message Queue)
NATS_URL=nats://localhost:4222

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKETS=phenotype-artifacts,phenotype-models,phenotype-packages

# Optional: CockroachDB (Global SQL)
# COCKROACH_URL=postgresql://root@localhost:26257?sslmode=disable
